{% macro generate_unlockable_asset(guid, name) %}
<Asset>
  <Template>UnlockableAsset</Template>
  <Values>
    <Standard>
      <GUID>{{ guid }}</GUID>
      <Name>{{ name }}</Name>
    </Standard>
    <Locked/>
  </Values>
</Asset>{% endmacro %}
<ModOps>
  <ModOp Type="add" GUID="1500004636" Path="Values/Trigger/ResetTrigger/Values/Trigger/TriggerActions">
    <Item>
      <TriggerAction>
        <Template>ActionExecuteScript</Template>
        <Values>
          <Action />
          <ActionExecuteScript>
            <ScriptFileName>data/archipelago/scripts/on_game_loaded.py</ScriptFileName>
          </ActionExecuteScript>
        </Values>
      </TriggerAction>
    </Item>
  </ModOp>

  <!-- Removals don't have to care about DLCs, just remove everything -->
{% for trigger_guid, (unhide_guids, unlock_guids) in lock_guids_by_trigger.items() %}
{% if unhide_guids %}
  <ModOp Type="remove" GUID="{{ trigger_guid }}" Path="/Values/Trigger/TriggerActions/Item/TriggerAction/Values/ActionUnlockAsset/UnhideAssets/Item[Asset='{{ unhide_guids[0] }}'{% for unhide_guid in unhide_guids[1:] %} or Asset='{{ unhide_guid }}'{% endfor %}]" />
{% endif %}
{% if unlock_guids %}
  <ModOp Type="remove" GUID="{{ trigger_guid }}" Path="/Values/Trigger/TriggerActions/Item/TriggerAction/Values/ActionUnlockAsset/UnlockAssets/Item[Asset='{{ unlock_guids[0] }}'{% for unlock_guid in unlock_guids[1:] %} or Asset='{{ unlock_guid }}'{% endfor %}]" />
{% endif %}
{% endfor %}

  <!-- Remove palace ministry unhide at 1 investor -->
  <ModOp Type="remove" GUID="130295" Path="/Values/Trigger/TriggerActions/Item/TriggerAction/Values/ActionUnlockAsset/UnhideAssets/Item[Asset='269602']" />

  <!-- Add all unlockable assets-->
  <ModOp Type="addNextSibling" GUID="105568">
{% for name, (guid, _, _, _, _) in recipe_unlocks.items() %}
{{  generate_unlockable_asset(guid, name) | indent(4, true) }}
{% endfor %}
{% for name, (guid, _, _, _) in hacienda_quarter_unlocks.items() %}
{{  generate_unlockable_asset(guid, name) | indent(4, true) }}
{% endfor %}
{% for name, guid in expedition_unlocks.items() %}
{{  generate_unlockable_asset(guid, name) | indent(4, true) }}
{% endfor %}
{% for location in locations %}
{% if location.data.guid %}
{{  generate_unlockable_asset(location.data.guid, "Unlock: " + location.name) | indent(4, true) }}
{% endif %}
{% endfor %}
{{  generate_unlockable_asset(victory_trigger.actions[0].unlock_guids[0], "Victory Condition") | indent(4, true) }}
  </ModOp>

{% from 'triggers.util.xml' import generate_trigger_asset, generate_trigger_condition with context %}
  <!-- Make expedition unlocks dependent on custom unlocks -->
  <ModOp Type="replace" GUID="140885" Path="/Values/Trigger/TriggerCondition">
{{( generate_trigger_condition(TriggerCondition.UNLOCK("", Region(0), guid=expedition_unlocks["Expedition: New World"])) | indent(4, true)).rstrip() }}
  </ModOp>
  <ModOp Type="replace" GUID="113818" Path="/Values/Trigger/TriggerCondition">
{{( generate_trigger_condition(TriggerCondition.UNLOCK("", Region(0), guid=expedition_unlocks["Expedition: Cape Trelawney"])) | indent(4, true)).rstrip() }}
  </ModOp>
  <ModOp Type="remove" GUID="113818" Path="Values/Trigger/SubTriggers/Item[SubTrigger/Values/Trigger/TriggerCondition/Template='ConditionTimer']" />
  <ModOp Type="replace" GUID="114115" Path="/Values/Trigger/SubTriggers/Item/SubTrigger/Values/Trigger">
    <Trigger>
{{(   generate_trigger_condition(TriggerCondition.UNLOCK("", Region(0), guid=expedition_unlocks["Expedition: The Arctic"])) | indent(6, true)).rstrip() }}
    </Trigger>
  </ModOp>
  <ModOp Type="replace" GUID="119863" Path="/Values/Trigger/SubTriggers/Item/SubTrigger/Values/Trigger">
    <Trigger>
{{(   generate_trigger_condition(TriggerCondition.UNLOCK("", Region(0), guid=expedition_unlocks["Expedition: Enbesa"])) | indent(6, true)).rstrip() }}
    </Trigger>
  </ModOp>

  <!-- Remove timers from silo and tractor newspapers and make tractor newspaper independent from silos -->
  <ModOp Type="remove" GUID="270008" Path="Values/Trigger/SubTriggers" />
  <ModOp Type="replace" GUID="269865" Path="/Values/Trigger/TriggerCondition">
{{( generate_trigger_condition(TriggerCondition.TRUE()) | indent(4, true)).rstrip() }}
  </ModOp>
  <ModOp Type="remove" GUID="269865" Path="Values/Trigger/SubTriggers/Item/SubTrigger/Values/Trigger/SubTriggers" />
  <ModOp Type="replace" GUID="269865" Path="/Values/Trigger/SubTriggers/Item/SubTrigger/Values/Trigger/TriggerCondition">
{{( generate_trigger_condition(TriggerCondition.UNLOCK("", Region(0), guid=269832)) | indent(4, true)).rstrip() }}
  </ModOp>
  
  <!-- Make recipe unlocks dependent on custom unlocks and remove unlock delays if necessary -->
{% for recipe_guid, feature_guid, unlock_guid, quest_guid, wipe_subtriggers in recipe_unlocks.values() %}
  <ModOp Type="replace" GUID="{{ feature_guid }}" Path="/Values/Trigger/TriggerCondition">
{{( generate_trigger_condition(TriggerCondition.UNLOCK("", Region(0), guid=recipe_guid)) | indent(4, true)).rstrip() }}
  </ModOp>
{% if (unlock_guid != 0) and (quest_guid != 0) %}
  <ModOp Type="replace" GUID="{{ feature_guid }}" Path="/Values/Trigger/TriggerActions">
    <TriggerActions>
      <Item>
        <TriggerAction>
          <Template>ActionUnlockAsset</Template>
          <Values>
            <Action/>
            <ActionUnlockAsset>
              <UnlockAssets>
                <Item>
                  <Asset>{{ unlock_guid }}</Asset>
                </Item>
              </UnlockAssets>
            </ActionUnlockAsset>
          </Values>
        </TriggerAction>
      </Item>
      <Item>
        <TriggerAction>
          <Template>ActionStartQuest</Template>
          <Values>
            <Action/>
            <ActionStartQuest>
              <Quest>{{ quest_guid }}</Quest>
              <QuestSession>5000000</QuestSession>
            </ActionStartQuest>
          </Values>
        </TriggerAction>
      </Item>
    </TriggerActions>
  </ModOp>
{% endif %}
{% if wipe_subtriggers %}
  <ModOp Type="replace" GUID="{{ feature_guid }}" Path="/Values/Trigger/SubTriggers">
    <SubTriggers />
  </ModOp>
{% endif%}
{% endfor %}

  <!-- Move empires of the skies items out of airship asset pools -->
  <ModOp Type="add" GUID="2006" Path="/Values/Trigger/TriggerActions/Item/TriggerAction/Values/ActionUnlockAsset/UnlockAssets">
    <Item>
      <Asset>2273</Asset>
    </Item>
  </ModOp>

  <!-- Add all triggers -->
  <ModOp Type="addNextSibling" GUID="130248">
    <!-- Grant start items -->
{{  generate_trigger_asset(start_trigger) | indent(4, true) }}

    <!-- Unhide palace ministry with palace unlock -->
{{  generate_trigger_asset(palace_ministry_unhide_trigger) | indent(4, true) }}

    <!-- Unlock triggers -->
{%  for trigger in location_triggers %}
{{  generate_trigger_asset(trigger) | indent(4, true) }}
{%  endfor %}
{%  for trigger in hacienda_quarter_triggers %}
{{  generate_trigger_asset(trigger) | indent(4, true) }}
{%  endfor %}

    <!-- Notification triggers -->
{%  for trigger in notification_triggers %}
{{  generate_trigger_asset(trigger, "Notification: ") | indent(4, true) }}
{%  endfor %}

    <!-- Victory condition trigger -->
{{  generate_trigger_asset(victory_trigger) | indent(4, true) }}
  </ModOp>
</ModOps>