{% macro generate_trigger_actions(has_unlocks, has_unhides, location_data) %}
<TriggerActions>
  <Item>
    <TriggerAction>
      <Template>ActionUnlockAsset</Template>
      <Values>
        <Action/>
        <ActionUnlockAsset>
{%        if has_unlocks %}
          <UnlockAssets>
{%        for guid, _, unlock_guids, _ in location_data %}
            <Item>
              <Asset>{{ guid }}</Asset>
            </Item>
{%        for unlock_guid in unlock_guids %}
            <Item>
              <Asset>{{ unlock_guid }}</Asset>
            </Item>
{%        endfor %}
{%        endfor %}
          </UnlockAssets>
{%        else %}
          <UnlockAssets />
{%        endif %}
{%        if has_unhides %}
          <UnhideAssets>
{%        for _, _, _, unhide_guids in location_data %}
{%        for unhide_guid in unhide_guids %}
            <Item>
              <Asset>{{ unhide_guid }}</Asset>
            </Item>
{%        endfor %}
{%        endfor %}
          </UnhideAssets>
{%        else %}
          <UnhideAssets />
{%        endif %}
        </ActionUnlockAsset>
      </Values>
    </TriggerAction>
  </Item>
</TriggerActions>
{% endmacro %}

{% macro generate_trigger_condition(TriggerType, trigger_data) %}
{% if trigger_data.trigger_type == TriggerType.TRUE %}
<TriggerCondition>
  <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
  <Values>
    <Condition />
    <ConditionAlwaysTrue />
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.ALL %}
<TriggerCondition>
  <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
  <Values>
    <Condition>
      <SubConditionCompletionOrder>Parallel</SubConditionCompletionOrder>
    </Condition>
    <ConditionAlwaysTrue />
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.LINEAR %}
<TriggerCondition>
  <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
  <Values>
    <Condition>
      <SubConditionCompletionOrder>Linear</SubConditionCompletionOrder>
    </Condition>
    <ConditionAlwaysTrue />
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.ANY %}
<TriggerCondition>
  <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
  <Values>
    <Condition>
      <SubConditionCompletionOrder>MutuallyExclusive</SubConditionCompletionOrder>
    </Condition>
    <ConditionAlwaysTrue />
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.SESSION_ENTER %}
<TriggerCondition>
  <Template>ConditionActiveSession</Template>
  <Values>
    <Condition />
    <ConditionActiveSession>
      <ActiveSession>{{ trigger_data.session.guid }}</ActiveSession>
    </ConditionActiveSession>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.POPULATION %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition />
    <ConditionPlayerCounter>
      <PlayerCounter>PopulationByLevel</PlayerCounter>
      <Context>{{ trigger_data.guid }}</Context>
      <CounterAmount>{{ trigger_data.amount }}</CounterAmount>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.POPULATION_HAPPINESS %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition />
      <ConditionPlayerCounter>
        <PlayerCounter>PopulationHappinessByLevel</PlayerCounter>
        <Context>{{ trigger_data.guid }}</Context>
        <CounterAmount>{{ trigger_data.amount }}</CounterAmount>
        <CounterScope>Session</CounterScope>
        <CounterScopeUseCurrentContext>0</CounterScopeUseCurrentContext>
        <CounterScopeContext>{{ trigger_data.session.guid }}</CounterScopeContext>
      </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.UNLOCK %}
<TriggerCondition>
  <Template>ConditionUnlocked</Template>
  <Values>
    <Condition />
    <ConditionUnlocked>
      <UnlockNeeded>{{ trigger_data.guid }}</UnlockNeeded>
    </ConditionUnlocked>
    <ConditionPropsNegatable/>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.COUNTER %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition/>
    <ConditionPlayerCounter>
      <Context>{{ trigger_data.guid }}</Context>
      <CounterAmount>{{ trigger_data.amount }}</CounterAmount>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.COUNTER_GOOD_IN_REGION %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition/>
    <ConditionPlayerCounter>
      <PlayerCounter>GoodsInStock</PlayerCounter>
      <Context>{{ trigger_data.guid }}</Context>
      <CounterAmount>{{ trigger_data.amount }}</CounterAmount>
      <CounterScope>Region</CounterScope>
      <CounterScopeUseCurrentContext>0</CounterScopeUseCurrentContext>
      <CounterScopeContext>{{ trigger_data.region.guids[0] }}</CounterScopeContext>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.COUNTER_EXPEDITION_SOLVED %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition/>
    <ConditionPlayerCounter>
      <PlayerCounter>ExpeditionSolved</PlayerCounter>
      <Context>{{ trigger_data.guid }}</Context>
      <CounterAmount>{{ trigger_data.amount }}</CounterAmount>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.QUEST_COMPLETE %}
<TriggerCondition>
  <Template>ConditionQuestState</Template>
  <Values>
    <Condition/>
    <ConditionQuestState>
      <ConditionQuestStateStates>Reached</ConditionQuestStateStates>
      <ConditionQuestStateQuestGUID>{{ trigger_data.guid }}</ConditionQuestStateQuestGUID>
    </ConditionQuestState>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.EVENT_ACTIVE %}
<TriggerCondition>
  <Template>ConditionMonumentEventActive</Template>
  <Values>
    <Condition/>
    <ConditionMonumentEventsActive>
      <MonumentEventsActive>
        <Item>
          <MonumentEventGUID>{{ trigger_data.guid }}</MonumentEventGUID>
        </Item>
      </MonumentEventsActive>
    </ConditionMonumentEventsActive>
  </Values>
</TriggerCondition>
{% elif trigger_data.trigger_type == TriggerType.ACTIVE_DLC %}
<TriggerCondition>
  <Template>ConditionIsDLCActive</Template>
  <Values>
    <Condition/>
    <ConditionIsDLCActive>
      <DLCAssetList>
{%    for guid in trigger_data.guids %}
        <Item>
          <DLCAsset>{{ guid }}</DLCAsset>
        </Item>
{%    endfor %}
      </DLCAssetList>
    </ConditionIsDLCActive>
    <ConditionPropsNegatable/>
  </Values>
</TriggerCondition>
{% endif %}
{% endmacro %}

{% macro generate_sub_triggers(TriggerType, trigger_data) %}
{% if trigger_data.triggers|length > 0 and trigger_data.trigger_type == TriggerType.ALL or trigger_data.trigger_type == TriggerType.ANY or trigger_data.trigger_type == TriggerType.LINEAR %}
<SubTriggers>
{% for trigger in trigger_data.triggers %}
  <Item>
    <SubTrigger>
      <Template>AutoCreateTrigger</Template>
      <Values>
        <Trigger>
{{(       generate_trigger_condition(TriggerType, trigger) | indent(10, true)).rstrip(" ") -}}
{{(       generate_sub_triggers(TriggerType, trigger)      | indent(10, true)).rstrip(" ") -}}
{{     "</Trigger>"                                        | indent(8, true)                }}
      </Values>
    </SubTrigger>
  </Item>
{% endfor %}
</SubTriggers>
{% endif %}
{% endmacro %}

{% macro generate_trigger_asset(TriggerType, trigger_guid, trigger_data, has_unlocks, has_unhides, location_data) %}
<Asset>
  <Template>Trigger</Template>
  <Values>
    <Standard>
      <GUID>{{ trigger_guid }}</GUID>
      <Name>{{ trigger_data.ap_location_name }}</Name>
    </Standard>
    <Trigger>
{{(   generate_trigger_condition(TriggerType, trigger_data)             | indent(6, true)).rstrip(" ") -}}
{{(   generate_trigger_actions(has_unlocks, has_unhides, location_data) | indent(6, true)).rstrip(" ") -}}
{{(   generate_sub_triggers(TriggerType, trigger_data)                  | indent(6, true)).rstrip(" ") -}}
{{   "<ResetTrigger>"                                                   | indent(6, true)               }}
        <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
        <Values>
          <EmptyAutoCreateValue/>
        </Values>
      </ResetTrigger>
    </Trigger>
    <TriggerSetup>
      <UsedBySecondParties>0</UsedBySecondParties>
    </TriggerSetup>
  </Values>
</Asset>{% endmacro %}