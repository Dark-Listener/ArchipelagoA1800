{% macro generate_trigger_actions(trigger_actions) %}
<TriggerActions>
{% for action in trigger_actions %}
  <Item>
    <TriggerAction>
{%    if action.type_ == TriggerActionType.UNLOCK %}
      <Template>ActionUnlockAsset</Template>
      <Values>
        <Action/>
        <ActionUnlockAsset>
{%        if action.unlock_guids %}
          <UnlockAssets>
{%        for guid in action.unlock_guids %}
            <Item>
              <Asset>{{ guid }}</Asset>
            </Item>
{%        endfor %}
          </UnlockAssets>
{%        else %}
          <UnlockAssets />
{%        endif %}
{%        if action.unhide_guids %}
          <UnhideAssets>
{%        for guid in action.unhide_guids %}
            <Item>
              <Asset>{{ guid }}</Asset>
            </Item>
{%        endfor %}
          </UnhideAssets>
{%        else %}
          <UnhideAssets />
{%        endif %}
        </ActionUnlockAsset>
      </Values>
{%    elif action.action_type == TriggerActionType.SIDE_NOTIFICATION %}
{%    endif %}
    </TriggerAction>
  </Item>
{% endfor %}
</TriggerActions>
{% endmacro %}

{% macro generate_trigger_condition(trigger_condition) %}
{% if trigger_condition.type_ == TriggerConditionType.TRUE %}
<TriggerCondition>
  <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
  <Values>
    <Condition />
    <ConditionAlwaysTrue />
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.ALL %}
<TriggerCondition>
  <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
  <Values>
    <Condition>
      <SubConditionCompletionOrder>Parallel</SubConditionCompletionOrder>
    </Condition>
    <ConditionAlwaysTrue />
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.LINEAR %}
<TriggerCondition>
  <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
  <Values>
    <Condition>
      <SubConditionCompletionOrder>Linear</SubConditionCompletionOrder>
    </Condition>
    <ConditionAlwaysTrue />
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.ANY %}
<TriggerCondition>
  <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
  <Values>
    <Condition>
      <SubConditionCompletionOrder>MutuallyExclusive</SubConditionCompletionOrder>
    </Condition>
    <ConditionAlwaysTrue />
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.SESSION_ENTER %}
<TriggerCondition>
  <Template>ConditionActiveSession</Template>
  <Values>
    <Condition />
    <ConditionActiveSession>
      <ActiveSession>{{ trigger_condition.session.guid }}</ActiveSession>
    </ConditionActiveSession>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.POPULATION %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition />
    <ConditionPlayerCounter>
      <PlayerCounter>PopulationByLevel</PlayerCounter>
      <Context>{{ trigger_condition.guid }}</Context>
      <CounterAmount>{{ trigger_condition.amount }}</CounterAmount>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.POPULATION_HAPPINESS %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition />
      <ConditionPlayerCounter>
        <PlayerCounter>PopulationHappinessByLevel</PlayerCounter>
        <Context>{{ trigger_condition.guid }}</Context>
        <CounterAmount>{{ trigger_condition.amount }}</CounterAmount>
        <CounterScope>Session</CounterScope>
        <CounterScopeUseCurrentContext>0</CounterScopeUseCurrentContext>
        <CounterScopeContext>{{ trigger_condition.session.guid }}</CounterScopeContext>
      </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.UNLOCK %}
<TriggerCondition>
  <Template>ConditionUnlocked</Template>
  <Values>
    <Condition />
    <ConditionUnlocked>
      <UnlockNeeded>{{ trigger_condition.guid }}</UnlockNeeded>
    </ConditionUnlocked>
    <ConditionPropsNegatable />
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.COUNTER %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition />
    <ConditionPlayerCounter>
      <Context>{{ trigger_condition.guid }}</Context>
      <CounterAmount>{{ trigger_condition.amount }}</CounterAmount>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.COUNTER_GOOD_IN_REGION %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition />
    <ConditionPlayerCounter>
      <PlayerCounter>GoodsInStock</PlayerCounter>
      <Context>{{ trigger_condition.guid }}</Context>
      <CounterAmount>{{ trigger_condition.amount }}</CounterAmount>
      <CounterScope>Region</CounterScope>
      <CounterScopeUseCurrentContext>0</CounterScopeUseCurrentContext>
      <CounterScopeContext>{{ trigger_condition.region.guids[0] }}</CounterScopeContext>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.COUNTER_EXPEDITION_SOLVED %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition />
    <ConditionPlayerCounter>
      <PlayerCounter>ExpeditionSolved</PlayerCounter>
      <Context>{{ trigger_condition.guid }}</Context>
      <CounterAmount>{{ trigger_condition.amount }}</CounterAmount>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.QUEST_COMPLETE %}
<TriggerCondition>
  <Template>ConditionQuestState</Template>
  <Values>
    <Condition />
    <ConditionQuestState>
      <ConditionQuestStateStates>Reached</ConditionQuestStateStates>
      <ConditionQuestStateQuestGUID>{{ trigger_condition.guid }}</ConditionQuestStateQuestGUID>
    </ConditionQuestState>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.EVENT_ACTIVE %}
<TriggerCondition>
  <Template>ConditionMonumentEventActive</Template>
  <Values>
    <Condition />
    <ConditionMonumentEventsActive>
      <MonumentEventsActive>
        <Item>
          <MonumentEventGUID>{{ trigger_condition.guid }}</MonumentEventGUID>
        </Item>
      </MonumentEventsActive>
    </ConditionMonumentEventsActive>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.OBJECT_POSITION %}
<TriggerCondition>
  <Template>ConditionObjectPosition</Template>
  <Values>
    <Condition />
    <ConditionPropsSessionSettings />
    <ConditionObjectPosition>
      <Radius>{{ trigger_condition.distance }}</Radius>
      <ExpectObjectExists>0</ExpectObjectExists>
      <ExpectTargetExists>0</ExpectTargetExists>
    </ConditionObjectPosition>
    <ObjectFilter>
      <ObjectGUID>{{ trigger_condition.guid }}</ObjectGUID>
      <CheckParticipantID>1</CheckParticipantID>
      <CheckProcessingParticipantID>1</CheckProcessingParticipantID>
    </ObjectFilter>
    <ObjectTargetFilter>
      <TargetGUID>{{ trigger_condition.target_guid }}</TargetGUID>
      <TargetCheckProcessingParticipantID>1</TargetCheckProcessingParticipantID>
    </ObjectTargetFilter>
    <ConditionPropsNegatable />
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.ITEM_SET_ACTIVE %}
<TriggerCondition>
  <Template>ConditionPlayerCounter</Template>
  <Values>
    <Condition />
    <ConditionPlayerCounter>
      <PlayerCounter>ItemSetsActive</PlayerCounter>
      <Context>{{ trigger_condition.guid }}</Context>
      <CounterAmount>1</CounterAmount>
      <CounterScope>Region</CounterScope>
      <CounterScopeUseCurrentContext>0</CounterScopeUseCurrentContext>
      <CounterScopeContext>{{ trigger_condition.unlock_region.guids[0] }}</CounterScopeContext>
    </ConditionPlayerCounter>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.FACTORY_PRODUCTIVITY %}
<TriggerCondition>
  <Template>ConditionFactoryProductivity</Template>
  <Values>
    <Condition />
    <ConditionFactoryProductivity>
      <ProductivityThreshold>{{ trigger_condition.amount }}</ProductivityThreshold>
    </ConditionFactoryProductivity>
    <ObjectFilter>
      <ObjectGUID>{{ trigger_condition.guid }}</ObjectGUID>
      <CheckParticipantID>1</CheckParticipantID>
      <CheckProcessingParticipantID>1</CheckProcessingParticipantID>
    </ObjectFilter>
  </Values>
</TriggerCondition>
{% elif trigger_condition.type_ == TriggerConditionType.ACTIVE_DLC %}
<TriggerCondition>
  <Template>ConditionIsDLCActive</Template>
  <Values>
    <Condition />
    <ConditionIsDLCActive>
      <DLCAssetList>
{%    for guid in trigger_condition.guids %}
        <Item>
          <DLCAsset>{{ guid }}</DLCAsset>
        </Item>
{%    endfor %}
      </DLCAssetList>
    </ConditionIsDLCActive>
    <ConditionPropsNegatable />
  </Values>
</TriggerCondition>
{% endif %}
{% endmacro %}

{% macro generate_sub_triggers(trigger_condition) %}
{% if trigger_condition.conditions|length > 0 and trigger_condition.type_ in [TriggerConditionType.ALL, TriggerConditionType.ANY, TriggerConditionType.LINEAR] %}
<SubTriggers>
{% for subcondition in trigger_condition.conditions %}
  <Item>
    <SubTrigger>
      <Template>AutoCreateTrigger</Template>
      <Values>
        <Trigger>
{{(       generate_trigger_condition(subcondition) | indent(10, true)).rstrip(" ") -}}
{{(       generate_sub_triggers(subcondition)      | indent(10, true)).rstrip(" ") -}}
{{     "</Trigger>"                                | indent(8, true)                }}
      </Values>
    </SubTrigger>
  </Item>
{% endfor %}
</SubTriggers>
{% endif %}
{% endmacro %}

{% macro generate_trigger_asset(trigger) %}
<Asset>
  <Template>Trigger</Template>
  <Values>
    <Standard>
      <GUID>{{ trigger.guid }}</GUID>
      <Name>{{ trigger.condition.ap_location_name }}</Name>
    </Standard>
    <Trigger>
{{(   generate_trigger_condition(trigger.condition) | indent(6, true)).rstrip(" ") -}}
{{(   generate_trigger_actions(trigger.actions)     | indent(6, true)).rstrip(" ") -}}
{{(   generate_sub_triggers(trigger.condition)      | indent(6, true)).rstrip(" ") -}}
{{   "<ResetTrigger>"                               | indent(6, true)               }}
        <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
        <Values>
          <EmptyAutoCreateValue/>
        </Values>
      </ResetTrigger>
    </Trigger>
    <TriggerSetup>
      <UsedBySecondParties>0</UsedBySecondParties>
    </TriggerSetup>
  </Values>
</Asset>{% endmacro %}