{% macro generate_objective(trigger_condition) %}
{% if trigger_condition.type_ == TriggerConditionType.ALL %}
{% for subcondition in trigger_condition.conditions %}
{{ generate_objective(subcondition) }}{% endfor %}
{% elif trigger_condition.type_ == TriggerConditionType.POPULATION %}
<Item>
  <Objective>
    <Template>StatusQuoObjective</Template>
    <Values>
      <ConditionQuestObjective>
        <TextCombinedContextValue>12715</TextCombinedContextValue>
      </ConditionQuestObjective>
      <ConditionPlayerCounter>
        <PlayerCounter>PopulationByLevel</PlayerCounter>
        <Context>{{ trigger_condition.guid }}</Context>
        <CounterAmount>{{ trigger_condition.amount }}</CounterAmount>
      </ConditionPlayerCounter>
    </Values>
  </Objective>
</Item>
{% elif trigger_condition.type_ == TriggerConditionType.COUNTER %}
<Item>
  <Objective>
    <Template>StatusQuoObjective</Template>
    <Values>
      <ConditionQuestObjective>
{%      if trigger_condition.guid == 636 %}
        <TextCombinedContextValue>104803</TextCombinedContextValue>
{%      elif trigger_condition.guid == 635 %}
        <TextCombinedContextValue>104800</TextCombinedContextValue>
{%      else %}
        <TextCombinedContextValue>12714</TextCombinedContextValue>
{%      endif %}
      </ConditionQuestObjective>
      <ConditionPlayerCounter>
        <Context>{{ trigger_condition.guid }}</Context>
        <CounterAmount>{{ trigger_condition.amount }}</CounterAmount>
      </ConditionPlayerCounter>
    </Values>
  </Objective>
</Item>
{% endif %}
{% endmacro %}
{% macro generate_pre_condition(trigger_condition) %}
{% if trigger_condition.type_ == TriggerConditionType.ACTIVE_DLC %}
<Condition>
  <Template>ConditionIsDLCActive</Template>
  <Values>
    <Condition/>
    <ConditionIsDLCActive>
      <DLCAssetList>
{%    for guid in trigger_condition.guids %}
        <Item>
          <DLCAsset>{{ guid }}</DLCAsset>
        </Item>
{%    endfor %}
      </DLCAssetList>
    </ConditionIsDLCActive>
    <ConditionPropsNegatable/>
  </Values>
</Condition>
{% endif %}
{% endmacro %}
{% macro generate_quest_pool(quest_pool) %}
<Asset>
  <Template>QuestPool</Template>
  <Values>
    <Standard>
      <GUID>{{ quest_pool.guid }}</GUID>
      <Name>{{ quest_pool.name }}</Name>
    </Standard>
    <QuestPool>
      <Quests>
{%    for guid, weight in quest_pool.quests %}
        <Item>
          <Quest>{{ guid }}</Quest>
          <Weight>{{ weight }}</Weight>
        </Item>
{%    endfor %}
      </Quests>
      <IsTopLevel>1</IsTopLevel>
      <QuestLimit>{{ quest_pool.max_quests }}</QuestLimit>
      <PoolCooldown>0</PoolCooldown>
      <QuestCooldown>0</QuestCooldown>
    </QuestPool>
    <Locked>
      <DefaultLockedState>0</DefaultLockedState>
    </Locked>
{%  if quest_pool.pre_condition %}
    <PreConditionList>
{{(   generate_pre_condition(quest_pool.pre_condition) | indent(6, true)).rstrip(" ") -}}
{{ "</PreConditionList>"                               | indent(4, true)               }}
{%  endif %}
  </Values>
</Asset>
{% endmacro %}
{% macro generate_quest(quest) %}
<Asset>
  <Template>A7_QuestStatusQuo</Template>
  <Values>
    <Standard>
      <GUID>{{ quest.guid }}</GUID>
      <Name>{{ quest.name }}</Name>
    </Standard>
    <Text>
      <TextOverride>898</TextOverride>
    </Text>
    <Quest>
      <StarterMessage>
        <Notification>
          <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
          <Values>
            <CharacterNotification/>
            <BaseNotification/>
            <NotificationSubtitle/>
          </Values>
        </Notification>
        <SuppressMessage>1</SuppressMessage>
      </StarterMessage>
      <SuccessMessage>
        <Notification>
          <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
          <Values>
            <CharacterNotification/>
            <BaseNotification/>
            <NotificationSubtitle/>
          </Values>
        </Notification>
        <SuppressMessage>1</SuppressMessage>
      </SuccessMessage>
      <FailureMessage>
        <Notification>
          <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
          <Values>
            <CharacterNotification/>
            <BaseNotification/>
            <NotificationSubtitle/>
          </Values>
        </Notification>
        <SuppressMessage>1</SuppressMessage>
      </FailureMessage>
      <InvitationMessage>
        <Notification>
          <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
          <Values>
            <CharacterNotification/>
            <BaseNotification/>
            <NotificationSubtitle/>
          </Values>
        </Notification>
      </InvitationMessage>
      <QuestHints>
        <Item>
          <Text>{{ quest.description_guid }}</Text>
        </Item>
      </QuestHints>
      <QuestGiver>{{ quest.quest_giver }}</QuestGiver>
      <QuestTimeLimit>0</QuestTimeLimit>
      <QuestActivation>QuestStart</QuestActivation>
      <MaxCallOut>1</MaxCallOut>
      <MaxSolveCount>{{ quest.max_solve }}</MaxSolveCount>
      <IsAbortable>0</IsAbortable>
      <DelayTimer>{{ quest.delay }}</DelayTimer>
{%    if quest.visible %}
      <QuestTrackerVisibility>Global</QuestTrackerVisibility>
{%    else %}
      <QuestTrackerVisibility>Never</QuestTrackerVisibility>
{%    endif %}
      <HasExclusiveQuestGiver>0</HasExclusiveQuestGiver>
      <CanBeActiveForMultipleParticipants>1</CanBeActiveForMultipleParticipants>
      <ReputationQuestFail>
        <ReputationFailList />
      </ReputationQuestFail>
    </Quest>
{%  if quest.pre_condition %}
    <PreConditionList>
{{(   generate_pre_condition(quest.pre_condition) | indent(6, true)).rstrip(" ") -}}
{{ "</PreConditionList>"                          | indent(4, true)               }}    
{%  endif %}
    <Reward>
      <RewardAssets />
      <RewardReputation />
    </Reward>
    <Objectives>
      <WinConditions>
{{(      generate_objective(quest.condition) | indent(8, true)).rstrip(" ") -}}
{{   "</WinConditions>"                      | indent(6, true)               }}
    </Objectives>
    <QuestOptional>
      <HasStarterObject>None</HasStarterObject>
      <StarterObject>
        <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
        <Values>
          <Condition />
          <ConditionStarterObject />
          <ConditionQuestObjective />
          <ConditionPropsSessionSettings />
        </Values>
      </StarterObject>
    </QuestOptional>
  </Values>
</Asset>
{% endmacro %}
<ModOps>
  <!-- Add all quests -->
  <ModOp Type="addNextSibling" GUID="152264">
    <!-- Victory condition quest -->
{{  generate_quest(victory_quest) | indent(4, true) }}
  </ModOp>

  <!-- Add quest pool -->
  <ModOp Type="addNextSibling" GUID="150725">
{{  generate_quest_pool(victory_quest_pool) | indent(4, true) }}
  </ModOp>
</ModOps>