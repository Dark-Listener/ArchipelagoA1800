<ModOps>
  <Include File="./convert_to_multiplayer.include.xml" />
  <Include File="./free_goods_and_ships.include.xml" />
  <Include File="./incidents.include.xml" />
  <Include File="./notifications.include.xml" />
  <Include File="./quests.include.xml" />
  <Include File="./triggers.include.xml" />

  <!-- Unlock all regular needs (not luxury or lifestyle) at 1 population amount to allow filling needs earlier -->
  <ModOp Type="remove" Path="//PopulationLevel7/PopulationInputs/Item[SupplyWeight and not(IsBonusNeed)]/NoWeightPopulationCount" />

  <!-- Make scholar, advanced coffee, advanced rum, advanced cotton fabric, advanced pier permit research min. 5x faster -->
  <ModOp Type="replace" GUID="125340" Path="/Values/Godlike/CraftingConfig/MinimumWorkforceTime">
    <MinimumWorkforceTime>360000</MinimumWorkforceTime>
  </ModOp>
  <ModOp Type="replace" GUID="125340" Path="/Values/Godlike/CraftingConfig/MaximumWorkforceTime">
    <MaximumWorkforceTime>60000</MaximumWorkforceTime>
  </ModOp>
  <ModOp Type="replace" GUID="124844,124845,124849,124850" Path="/Values/Godlike/CraftingConfig/MinimumWorkforceTime">
    <MinimumWorkforceTime>1080000</MinimumWorkforceTime>
  </ModOp>
  <ModOp Type="replace" GUID="124844,124845,124849,124850" Path="/Values/Godlike/CraftingConfig/MaximumWorkforceTime">
    <MaximumWorkforceTime>60000</MaximumWorkforceTime>
  </ModOp>

  <!-- Adapt costs of The "Magnificone" Ice Cream Maker in order to reduce scrap grind -->
  <ModOp Type="replace" GUID="116188" Path="/Values/CraftableItem/CraftingCosts">
    <CraftingCosts>
      <Item>
        <Product>115980</Product>
        <Amount>10</Amount>
      </Item>
      <Item>
        <Product>120041</Product>
        <Amount>50</Amount>
      </Item>
      <Item>
        <Product>120014</Product>
        <Amount>50</Amount>
      </Item>
      <Item>
        <Product>1010258</Product>
        <Amount>50</Amount>
      </Item>
    </CraftingCosts>
  </ModOp>

  <!-- Make Hacienda menu visible once anything from it is unlocked -->
  <ModOp Type="remove" GUID="7281" Path="/Values/ConstructionCategory/BuildingList/Item[IgnoreUnlockStateForCategoryVisibility='1']/IgnoreUnlockStateForCategoryVisibility" />

  <!-- Lock Hacienda streets, store room, blank farm and blank brewery per default -->
  <ModOp Type="replace" GUID="24770,24775,25224,24794,24800" Path="/Values/Locked">
    <Locked>
			<DefaultLockedState>1</DefaultLockedState>
			<DLCDependency>24961</DLCDependency>
		</Locked>
  </ModOp>

  <!-- Lock later dam phases per default -->
  <ModOp Type="replace" GUID="6005,6006" Path="/Values/Locked/DefaultLockedState">
    <DefaultLockedState>1</DefaultLockedState>
  </ModOp>

  <!-- Don't archive unlock notification -->
  <ModOp Type="add" GUID="501378" Path="/Values/Notification/NotificationType/Values/SideNotification">
    <IsArchived>0</IsArchived>
  </ModOp>
</ModOps>
